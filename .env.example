# Copy to .env and adjust. .env is gitignored.

# Google Maps Geocoding API key — used to reverse-geocode the listing's
# coordinates into kode pos + kelurahan. Required: without it, /extract returns 500.
GOOGLE_MAPS_API_KEY=

# --- Optional scraper knobs (sensible defaults; rarely need changing) -------------
# Source base URL (override only if needed)
# BASE_URL=https://www.rumah123.com
# How the fetcher identifies itself
# USER_AGENT=listing-extractor/0.1
# Retry attempts on 429/5xx/timeout before giving up on a URL
# MAX_RETRIES=4
